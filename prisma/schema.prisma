generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([phone])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
}

model Product {
  id            String         @id @default(cuid())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  calories      Int            @default(0)
  proteins      Decimal        @db.Decimal(8, 1) @default(0)
  fats          Decimal        @db.Decimal(8, 1) @default(0)
  carbs         Decimal        @db.Decimal(8, 1) @default(0)
  grams         Int            @default(0)
  imageData     Bytes?
  imageMimeType String?
  categoryId    String?
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  menuItems     MenuSchedule[]
  orderItems    OrderItem[]

  @@index([isActive])
  @@index([categoryId])
}

model MenuSchedule {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, date])
  @@index([date])
}

model Order {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    OrderStatus @default(PENDING)
  total     Decimal     @db.Decimal(10, 2)
  items     OrderItem[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  @@index([orderId])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DELIVERED
  CANCELLED
}

/// Singleton: id всегда 1. Список получателей уведомлений (не секреты).
model NotificationSettings {
  id              Int      @id @default(1)
  adminEmails     String[] @default([])
  telegramChatIds String[] @default([])
  updatedAt       DateTime @updatedAt
}

/// Singleton: id всегда 1. Контент раздела «О нас».
model AboutInfo {
  id Int @id @default(1)

  title            String @default("")
  tagline          String @default("")
  shortDescription String @default("")
  fullDescription  String @default("")

  address     String @default("")
  addressNote String @default("")
  city        String @default("")
  postalCode  String @default("")

  phone          String @default("")
  phoneSecondary String @default("")
  email          String @default("")
  whatsapp       String @default("")
  telegram       String @default("")
  instagram      String @default("")
  vkontakte      String @default("")

  hoursWeekdays String @default("")
  hoursWeekend  String @default("")
  hoursNote     String @default("")

  deliveryInfo   String @default("")
  deliveryZones  String @default("")
  minOrderNote   String @default("")
  paymentMethods String @default("")

  parkingInfo String @default("")
  howToFind   String @default("")
  mapUrl      String @default("")

  legalName   String @default("")
  unp         String @default("")
  foundedYear String @default("")
  capacity    String @default("")
  amenities   String @default("")

  coverImageData     Bytes?
  coverImageMimeType String?

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  photos    AboutPhoto[]
}

model AboutPhoto {
  id            String    @id @default(cuid())
  aboutId       Int       @default(1)
  about         AboutInfo @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  imageData     Bytes
  imageMimeType String
  caption       String    @default("")
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([aboutId, sortOrder])
}
